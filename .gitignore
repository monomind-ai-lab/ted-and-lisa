# site/ is assembled at deploy time by site/sync.sh. Only the six canonical
# files are tracked: index.html, lisa-ppt.html, 404.html, llms.txt,
# robots.txt, sync.sh. The ignores below name assembled artefacts one by
# one rather than ignoring site/ wholesale, so a new canonical page is
# tracked the moment it is written.
site/previews/
site/intake.html
site/assets/
site/SKILL.md

# the skill checkout site/sync.sh reads from (the deploy workflow makes its
# own; locally you clone it yourself)
/.skill/

# wrangler local state
.wrangler/

.DS_Store
__pycache__/
*.pyc
